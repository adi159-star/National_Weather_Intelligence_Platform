# Firebase Web App Configuration
# Get these values from your Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Backend API Endpoint
VITE_API_URL=http://localhost:5000

# Mapbox Configuration
# Add your Mapbox public access token (starts with 'pk.eyJ...')
# You can obtain a free public token at https://account.mapbox.com/
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here
