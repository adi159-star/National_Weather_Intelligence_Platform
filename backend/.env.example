# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/weather_platform?appName=Cluster0

# Server Port
PORT=5000

# Frontend URL(s) for CORS (comma-separated if multiple)
FRONTEND_URL=https://national-weather-intelligence-platf-snowy.vercel.app,http://localhost:5173

# Firebase Admin Service Account (JSON string or base64 encoded for Render/hosting)
# Can be left blank locally if backend/config/serviceAccountKey.json is present
FIREBASE_SERVICE_ACCOUNT=
